# Used to get event logs instead of digging through the event viewer
# At the bottom is a commented out secondary script which when run as administrator outputs all possible options for 'LogName' in the hashtable below.

$FHT_Values = @{
    LogName   = 'Application'
    Level     = 1, 2
    StartTime = (Get-Date).AddDays(-1).Date
    EndTime   = (Get-Date).Date
}

Get-WinEvent -FilterHashtable $FHT_Values -MaxEvents 50


# Secondary script below to find values of LogName

<#
# Check if script is running as an administrator
$isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if (-not $isAdmin) { Read-Host "Needs to be run as administrator. Please re-run again as an administrator. Press Enter to Exit..."; exit }

$availableLogNames = Get-WinEvent -ListLog * |
Where-Object { $_.IsEnabled -eq $true -and $_.RecordCount -gt 0 } |
Select-Object LogName, RecordCount |
Sort-Object { $_.LogName.StartsWith('Microsoft-') }, LogName

Write-Output $availableLogNames
#>